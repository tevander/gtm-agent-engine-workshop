# Copy to .env and fill in your own values. Do NOT commit the real .env.

# LangSmith: Tracing and Observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
# Only needed for org-scoped API keys (lsv2_sk_...). Personal tokens (lsv2_pt_...)
# don't need this and will fail with a 401 if you leave a placeholder here.
# LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=northpoint-gtm-agent
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# Model provider: OAuth2 client credentials for the Cisco Mistral hub
CLIENT_ID=<your-client-id>
CLIENT_SECRET=<your-client-secret>
TOKEN_URL=<your-token-endpoint-url>
BASE_URL=https://cxaihub-nprd.cisco.com/mistral-medium/v1
# Optional: override the model (mistral-medium-2508 or magistral-medium-2507)
# MODEL_NAME=mistral-medium-2508

# App-level config: default dataset for eval.py
DATASET_NAME=gtm-agent-dataset